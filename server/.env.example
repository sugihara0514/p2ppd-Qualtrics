# Required: change for each experiment day, keep unchanged for same-day restarts.
EXPERIMENT_SESSION_ID=day01
# Empty means explicitly start without imported history. Set path for day02 onward.
MATCH_HISTORY_FILE=
# Production: MUST point to a persistent disk, e.g. /var/data/pd/matches.jsonl
MATCH_JOURNAL_FILE=./data/matches.jsonl
